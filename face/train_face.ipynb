import os, math, time
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader
import torchvision
from torchvision import transforms
from torchvision.utils import save_image
from PIL import Image

# ---------------- 数据集 ----------------
DATASET      = "anime"
DATASET_PATH = "/kaggle/input/datasets/splcher/animefacedataset"
DATA_ROOT    = "/kaggle/working/data"
OUTPUT_DIR   = "/kaggle/working"

# ---------------- 超参数 ----------------
IMAGE_SIZE   = 64
BATCH_SIZE   = 96
MAX_STEPS    = 30000
LR           = 2e-4
WARMUP_STEPS = 500
TIMESTEPS    = 1000
BASE_CH      = 64
CKPT_EVERY   = 2000
SAMPLE_EVERY = 500
LOG_EVERY    = 100
NUM_WORKERS  = 2          # ★ 回滚到 2（能跑的配置）
EMA_DECAY    = 0.999
RESUME       = True

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
os.makedirs(OUTPUT_DIR, exist_ok=True)
torch.manual_seed(0)
torch.backends.cudnn.benchmark = True
Image.MAX_IMAGE_PIXELS = 50_000_000    # ★ 防 OOM

def to_minus11(batch):
    x = batch[0] if isinstance(batch, (list, tuple)) else batch
    return x * 2 - 1

class FlatImageDataset(torch.utils.data.Dataset):
    EXTS = {".jpg", ".jpeg", ".png", ".bmp", ".webp"}
    MAX_FILE_BYTES = 5 * 1024 * 1024

    def __init__(self, root, transform=None):
        self.paths = []
        skipped = 0
        for dirpath, _, files in os.walk(root):
            for f in files:
                if os.path.splitext(f)[1].lower() not in self.EXTS:
                    continue
                p = os.path.join(dirpath, f)
                try:
                    if os.path.getsize(p) > self.MAX_FILE_BYTES:
                        skipped += 1
                        continue
                except OSError:
                    continue
                self.paths.append(p)
        if not self.paths:
            raise FileNotFoundError(f"{root} 下没找到任何图片")
        print(f"FlatImageDataset: 有效 {len(self.paths)} 张，跳过 {skipped} 张超大文件")
        self.transform = transform

    def __len__(self):
        return len(self.paths)

    def __getitem__(self, i):
        for attempt in range(3):
            idx = (i + attempt) % len(self.paths)
            try:
                with Image.open(self.paths[idx]) as img:
                    img = img.convert("RGB")
                return self.transform(img) if self.transform else img
            except Exception:
                continue
        return torch.zeros(3, IMAGE_SIZE, IMAGE_SIZE)

def build_loader():
    if DATASET == "synthetic":
        size, ch = 32, 3
        ds = torch.utils.data.TensorDataset(torch.rand(512, ch, size, size))
    elif DATASET == "mnist":
        size, ch = 28, 1
        ds = torchvision.datasets.MNIST(DATA_ROOT, train=True, download=True,
                                        transform=transforms.ToTensor())
    elif DATASET == "cifar10":
        size, ch = 32, 3
        ds = torchvision.datasets.CIFAR10(DATA_ROOT, train=True, download=True,
                                          transform=transforms.ToTensor())
    elif DATASET == "anime":
        size, ch = IMAGE_SIZE, 3
        tf = transforms.Compose([
            transforms.Resize(size, antialias=True),
            transforms.CenterCrop(size),
            transforms.ToTensor(),
        ])
        ds = FlatImageDataset(DATASET_PATH, transform=tf)
    else:
        raise ValueError(DATASET)

    # ★ 回滚到稳定配置
    loader = DataLoader(ds, batch_size=BATCH_SIZE, shuffle=True,
                        num_workers=NUM_WORKERS, drop_last=True,
                        pin_memory=True)
    print(f"数据集：{DATASET} {size}x{size}x{ch}，共 {len(ds)} 张图")
    return loader, to_minus11, size, ch

loader, to_minus11, IMG_SIZE, IMG_CH = build_loader()
print("✅ Cell 1 完成 | 设备:", device, "| 多卡:", torch.cuda.device_count() > 1)

# ============ Cell 2：模型 ============
def timestep_embedding(t, dim):
    half = dim // 2
    freqs = torch.exp(-math.log(10000) * torch.arange(half, device=t.device) / max(half - 1, 1))
    args = t[:, None].float() * freqs[None]
    return torch.cat([torch.sin(args), torch.cos(args)], dim=-1)

class ResBlock(nn.Module):
    def __init__(self, in_ch, out_ch, t_dim, groups=8):
        super().__init__()
        self.norm1 = nn.GroupNorm(groups, in_ch)
        self.conv1 = nn.Conv2d(in_ch, out_ch, 3, padding=1)
        self.t_mlp = nn.Linear(t_dim, out_ch)
        self.norm2 = nn.GroupNorm(groups, out_ch)
        self.conv2 = nn.Conv2d(out_ch, out_ch, 3, padding=1)
        self.skip  = nn.Conv2d(in_ch, out_ch, 1) if in_ch != out_ch else nn.Identity()
        self.act   = nn.SiLU()
    def forward(self, x, t_emb):
        h = self.conv1(self.act(self.norm1(x)))
        h = h + self.t_mlp(t_emb)[:, :, None, None]          # ★ t 注入每层
        h = self.conv2(self.act(self.norm2(h)))
        return h + self.skip(x)

class SelfAttention(nn.Module):
    def __init__(self, ch, groups=8):
        super().__init__()
        self.norm = nn.GroupNorm(groups, ch)
        self.qkv  = nn.Conv2d(ch, ch * 3, 1)
        self.proj = nn.Conv2d(ch, ch, 1)
    def forward(self, x):
        B, C, H, W = x.shape
        h = self.norm(x)
        q, k, v = self.qkv(h).chunk(3, dim=1)
        q = q.view(B, C, -1).transpose(1, 2)
        k = k.view(B, C, -1)
        attn = torch.softmax(q @ k * (C ** -0.5), dim=-1)
        v = v.view(B, C, -1).transpose(1, 2)
        out = (attn @ v).transpose(1, 2).view(B, C, H, W)
        return x + self.proj(out)

class Down(nn.Module):
    def __init__(self, in_ch, out_ch, t_dim, n_blocks=1):
        super().__init__()
        blocks = [ResBlock(in_ch, out_ch, t_dim)]
        for _ in range(n_blocks - 1):
            blocks.append(ResBlock(out_ch, out_ch, t_dim))
        self.blocks = nn.ModuleList(blocks)
    def forward(self, x, t_emb):
        for b in self.blocks:
            x = b(x, t_emb)
        return x

class Up(nn.Module):
    def __init__(self, in_ch, skip_ch, out_ch, t_dim, n_blocks=1):
        super().__init__()
        self.reduce = nn.Conv2d(in_ch + skip_ch, out_ch, 1)   # ★ 1×1 降维控制参数
        blocks = [ResBlock(out_ch, out_ch, t_dim)]
        for _ in range(n_blocks - 1):
            blocks.append(ResBlock(out_ch, out_ch, t_dim))
        self.blocks = nn.ModuleList(blocks)
    def forward(self, x, skip, t_emb):
        x = F.interpolate(x, size=skip.shape[-2:], mode="nearest")
        x = self.reduce(torch.cat([x, skip], dim=1))
        for b in self.blocks:
            x = b(x, t_emb)
        return x

class UNet(nn.Module):
    """约 8.8M 参数（base_ch=64，3 级下采样）"""
    def __init__(self, in_ch=3, base_ch=64, t_dim=256):
        super().__init__()
        chs = [base_ch, base_ch * 2, base_ch * 4]  # 64, 128, 256
        self.t_dim = t_dim
        self.time_mlp = nn.Sequential(
            nn.Linear(t_dim, t_dim), nn.SiLU(), nn.Linear(t_dim, t_dim))
        self.init_conv = nn.Conv2d(in_ch, chs[0], 3, padding=1)

        self.down0 = Down(chs[0], chs[0], t_dim, n_blocks=1)
        self.pool0 = nn.Conv2d(chs[0], chs[0], 3, stride=2, padding=1)
        self.down1 = Down(chs[0], chs[1], t_dim, n_blocks=2)
        self.pool1 = nn.Conv2d(chs[1], chs[1], 3, stride=2, padding=1)
        self.down2 = Down(chs[1], chs[2], t_dim, n_blocks=2)
        self.pool2 = nn.Conv2d(chs[2], chs[2], 3, stride=2, padding=1)

        self.mid_res  = ResBlock(chs[2], chs[2], t_dim)
        self.mid_attn = SelfAttention(chs[2])

        self.up2 = Up(chs[2], chs[2], chs[2], t_dim, n_blocks=2)
        self.up1 = Up(chs[2], chs[1], chs[1], t_dim, n_blocks=2)
        self.up0 = Up(chs[1], chs[0], chs[0], t_dim, n_blocks=1)

        self.out_norm = nn.GroupNorm(8, chs[0])
        self.out_conv = nn.Conv2d(chs[0], in_ch, 3, padding=1)

    def forward(self, x, t):
        t_emb = self.time_mlp(timestep_embedding(t, self.t_dim))
        h = self.init_conv(x)
        h0 = self.down0(h, t_emb)
        h = self.pool0(h0)
        h1 = self.down1(h, t_emb)
        h = self.pool1(h1)
        h2 = self.down2(h, t_emb)
        h = self.pool2(h2)
        h = self.mid_res(h, t_emb)
        h = self.mid_attn(h)
        h = self.up2(h, h2, t_emb)
        h = self.up1(h, h1, t_emb)
        h = self.up0(h, h0, t_emb)
        return self.out_conv(F.silu(self.out_norm(h)))


def cosine_beta_schedule(T, s=0.008):
    """★ 替换 linear β，避免大 t 段塌缩"""
    steps = T + 1
    x = torch.linspace(0, T, steps)
    ac = torch.cos(((x / T) + s) / (1 + s) * math.pi * 0.5) ** 2
    ac = ac / ac[0]
    return torch.clip(1 - (ac[1:] / ac[:-1]), 0.0001, 0.9999)


class DDPM:
    def __init__(self, model, T, device):
        self.model, self.T, self.device = model, T, device
        self.betas = cosine_beta_schedule(T).to(device)          # ★ cosine
        self.alphas = 1.0 - self.betas
        self.ac = torch.cumprod(self.alphas, dim=0)
        self.ac_prev = torch.cat([torch.ones(1, device=device), self.ac[:-1]])
        self.sqrt_ac = torch.sqrt(self.ac)
        self.sqrt_omac = torch.sqrt(1 - self.ac)
        self.posterior_var = self.betas * (1 - self.ac_prev) / (1 - self.ac)

    def q_sample(self, x0, t, noise):
        return (self.sqrt_ac[t][:, None, None, None] * x0 +
                self.sqrt_omac[t][:, None, None, None] * noise)

    @torch.no_grad()
    def sample(self, n, size, ch, device, steps=50):
        """★ DDIM 采样，50 步即可，速度 ×20"""
        x = torch.randn(n, ch, size, size, device=device)
        ts = torch.linspace(self.T - 1, 0, steps).long().to(device)
        for i, t in enumerate(ts):
            t_batch = torch.full((n,), t, device=device, dtype=torch.long)
            eps = self.model(x, t_batch)
            ac_t = self.ac[t]
            x0 = (x - torch.sqrt(1 - ac_t) * eps) / torch.sqrt(ac_t)
            x0 = x0.clamp(-1, 1)                                  # ★ 稳定 x0
            if i < len(ts) - 1:
                ac_prev = self.ac[ts[i + 1]]
                x = torch.sqrt(ac_prev) * x0 + torch.sqrt(1 - ac_prev) * eps
            else:
                x = x0
        return x.clamp(-1, 1)                                     # ★ 输出 clamp


class EMA:
    def __init__(self, model, decay=0.9999):
        self.decay = decay
        self.shadow = {k: v.detach().clone() for k, v in model.state_dict().items()}

    @torch.no_grad()
    def update(self, model):
        for k, v in model.state_dict().items():
            if v.dtype.is_floating_point:
                self.shadow[k].mul_(self.decay).add_(v.detach(), alpha=1 - self.decay)
            else:
                self.shadow[k].copy_(v)

    @torch.no_grad()
    def copy_to(self, model):
        # ★ 深拷贝，防止主权重被 EMA 污染（原 bug 的根因）
        backup = {k: v.detach().clone() for k, v in model.state_dict().items()}
        model.load_state_dict(self.shadow)
        return backup

print("✅ Cell 2 完成")

# ============ Cell 3：训练 ============
net = UNet(in_ch=IMG_CH, base_ch=BASE_CH).to(device)
ddpm = DDPM(net, TIMESTEPS, device)
ema  = EMA(net, decay=EMA_DECAY)
opt  = torch.optim.AdamW(net.parameters(), lr=LR)

# ★ LR warmup：前 500 步线性升，之后余弦退火
def lr_lambda(step):
    if step < WARMUP_STEPS:
        return (step + 1) / WARMUP_STEPS
    progress = (step - WARMUP_STEPS) / max(MAX_STEPS - WARMUP_STEPS, 1)
    return 0.5 * (1 + math.cos(math.pi * progress)) * 0.9 + 0.1
scheduler = torch.optim.lr_scheduler.LambdaLR(opt, lr_lambda)

scaler = torch.amp.GradScaler("cuda", enabled=(device.type == "cuda"))
net_dp = nn.DataParallel(net) if torch.cuda.device_count() > 1 else net

step = 0
ckpt_path = os.path.join(OUTPUT_DIR, "checkpoint.pt")
if RESUME and os.path.exists(ckpt_path):
    ck = torch.load(ckpt_path, map_location=device, weights_only=False)
    net.load_state_dict(ck["model"])
    # ★ 核心修改：不要加载旧的 EMA 状态，让 EMA 从当前网络状态重新开始
    ema = EMA(net, decay=EMA_DECAY) # 重新初始化
    opt.load_state_dict(ck["opt"])
    scaler.load_state_dict(ck["scaler"])
    scheduler.load_state_dict(ck["scheduler"])
    step = ck["step"]
    print(f"✅ 从 checkpoint 恢复：step={step}，EMA 已重置为 {EMA_DECAY}")

print(f"参数量：{sum(p.numel() for p in net.parameters()) / 1e6:.2f}M")

def save_samples(tag):
    backup = ema.copy_to(net)            # ★ 深拷贝备份
    net.eval()
    x = ddpm.sample(64, IMG_SIZE, IMG_CH, device, steps=50)  # ★ DDIM 50 步
    # ★ 质量诊断
    flat = x.flatten(1)
    diversity = torch.cdist(flat, flat).mean().item()
    sharpness = x.diff(dim=-1).abs().mean().item()
    net.train()
    net.load_state_dict(backup)
    path = os.path.join(OUTPUT_DIR, f"samples_{tag}.png")
    save_image(x * 0.5 + 0.5, path, nrow=8)
    print(f"🖼  {path} | diversity {diversity:.2f} | sharpness {sharpness:.4f}", flush=True)

def save_ckpt():
    torch.save({"step": step, "model": net.state_dict(), "ema": ema.shadow,
                "opt": opt.state_dict(), "scaler": scaler.state_dict(),
                "scheduler": scheduler.state_dict()}, ckpt_path)
    print(f"💾 checkpoint 已保存（step={step}）", flush=True)

net.train()
t0, loss_acc, seen = time.time(), 0.0, 0

while step < MAX_STEPS:
    for batch in loader:
        if step >= MAX_STEPS:
            break

        x0 = to_minus11(batch).to(device, non_blocking=True)   # ★ 统一变量名
        t  = torch.randint(0, TIMESTEPS, (x0.shape[0],), device=device)
        noise = torch.randn_like(x0)
        x_t = ddpm.q_sample(x0, t, noise)

        with torch.autocast(device_type=device.type, enabled=(device.type == "cuda")):
            eps_pred = net_dp(x_t, t)
            loss = F.mse_loss(eps_pred.float(), noise)

        opt.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        scaler.step(opt)
        scaler.update()
        scheduler.step()
        ema.update(net)                                        # ★ 每步更新 EMA

        step += 1
        loss_acc += loss.item() * x0.shape[0]
        seen += x0.shape[0]

        if step % LOG_EVERY == 0:
            cur_lr = opt.param_groups[0]["lr"]
            print(f"step {step:>6} | loss {loss_acc/seen:.4f} | lr {cur_lr:.2e} | "
                  f"{seen/(time.time()-t0):.0f} img/s", flush=True)
            loss_acc, seen, t0 = 0.0, 0, time.time()

        if step % SAMPLE_EVERY == 0:
            save_samples(step)
        if step % CKPT_EVERY == 0:
            save_ckpt()

save_ckpt()
save_samples("final")
print(f"✅ Cell 3 完成：训练到 step={step}")
